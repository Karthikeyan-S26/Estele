# Estele Mobile API - production deployment (SHARED production DB, own Hostinger hosting)
# Deploy target: OUR OWN Hostinger hosting - NEVER tcongsinfotech/jewellery,
# never the company pipeline, never the existing website's document root.
# The API reads/writes the SAME production MySQL the live website uses, so the
# app mirrors the live storefront (products/customers/carts/orders).
#
# Copy to .env ON THE DEPLOY HOST and fill secrets there directly in Hostinger.
# NEVER commit real values. NEVER paste production credentials into chat.

APP_NAME=Estele API
APP_ENV=production
APP_DEBUG=false
APP_KEY=__(run `php artisan key:generate` ON THE HOST after first deploy)__
APP_URL=https://__(our api subdomain, e.g. api.<domain>)__
APP_API_URL=${APP_URL}/api

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# SHARED production MySQL (same database as the live website - no second copy)
DB_CONNECTION=mysql
DB_HOST=__(production mysql host)__
DB_PORT=3306
DB_DATABASE=__(production db name)__
DB_USERNAME=__(production db user)__
DB_PASSWORD=__(production db password)__

SESSION_DRIVER=database
SESSION_LIFETIME=2628000
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_CONVERSIONS_DISK=public

MAIL_MAILER=log
MAIL_HOST=__(smtp host, only if mailer != log)__
MAIL_PORT=587
MAIL_USERNAME=__(secret)__
MAIL_PASSWORD=__(secret)__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@estele.co
MAIL_FROM_NAME="${APP_NAME}"

# OTP delivery - SAME provider config as production so codes actually arrive.
# Leave SMS_DRIVER blank AND all gateway keys blank ONLY for a local smoke
# test (LogOtpGateway); production MUST set one real gateway.
SMS_DRIVER=twilio
VAS_SMS_API_KEY=__(secret)__
VAS_SMS_SENDER=TCONGS
VAS_SMS_ENTITY_ID=__(secret)__
VAS_SMS_TEMPLATE_ID=__(secret)__
VAS_SMS_MESSAGE_TEMPLATE=Your Estele OTP is %s
SMS_CA_BUNDLE=
TWILIO_SID=__(secret)__
TWILIO_AUTH_TOKEN=__(secret)__
TWILIO_VERIFY_SERVICE_SID=__(secret)__
TWILIO_PHONE_NUMBER=
WHATSAPP_DRIVER=log
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=__(secret)__
WHATSAPP_API_URL=
WHATSAPP_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Payments - same keys as production so Razorpay/Shiprocket orders flow
SHIPROCKET_EMAIL=__(secret)__
SHIPROCKET_PASSWORD=__(secret)__
SHIPROCKET_PICKUP_PINCODE=__(pickup pincode)__
RAZORPAY_KEY_ID=__(secret)__
RAZORPAY_KEY_SECRET=__(secret)__
RAZORPAY_WEBHOOK_SECRET=__(secret)__
FASTRR_CATALOG_TOKEN=__(secret, only if v1 Fastrr catalog is consumed)__

# Search (optional full-text; falls back to collection driver when blank)
SCOUT_DRIVER=collection

# Error tracking (optional)
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

VITE_APP_NAME="${APP_NAME}"
