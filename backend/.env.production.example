# Estele Mobile API - production deployment (Option B: SHARED production DB)
# Deploy target: our OWN infra (not tcongsinfotech/jewellery). Do NOT deploy
# through the company pipeline. Point DB_* at the SAME production MySQL that
# the live website (estele.ghrihum-realestate.com) uses, so the app mirrors
# the live storefront with the same products/customers/carts/orders.
#
# Copy to .env on the deploy host and fill secrets there. NEVER commit real values.

APP_NAME=Estele API
APP_ENV=production
APP_KEY=base64:__(run: php artisan key:generate --show, then paste)__
APP_DEBUG=false

# Public HTTPS URL of THIS deployment
APP_URL=https://__(our deploy domain)__
APP_API_URL=${APP_URL}/api

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# SHARED production MySQL (same database as the live website)
DB_CONNECTION=mysql
DB_HOST=__(production mysql host)__
DB_PORT=3306
DB_DATABASE=__(production db name)__
DB_USERNAME=__(production db user)__
DB_PASSWORD=__(production db password)__

SESSION_DRIVER=database
SESSION_LIFETIME=2628000
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
MEDIA_CONVERSIONS_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@estele.co
MAIL_FROM_NAME="${APP_NAME}"

# OTP delivery - use the SAME SMS provider config as production so codes sent
# by the app are the same codes users receive. e.g. twilio/vas/log
SMS_DRIVER=twilio
TWILIO_SID=__(secret)__
TWILIO_AUTH_TOKEN=__(secret)__
TWILIO_VERIFY_SERVICE_SID=__(secret)__
WHATSAPP_DRIVER=log
TWILIO_WHATSAPP_FROM=

# Payments - same keys as production so razorpay orders flow correctly
SHIPROCKET_EMAIL=__(secret)__
SHIPROCKET_PASSWORD=__(secret)__
SHIPROCKET_PICKUP_PINCODE=__(pickup pincode)__
RAZORPAY_KEY_ID=__(secret)__
RAZORPAY_KEY_SECRET=__(secret)__
RAZORPAY_WEBHOOK_SECRET=__(secret)__

# Optional error tracking
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production

# Meilisearch (optional full-text; falls back to collection driver)
SCOUT_DRIVER=collection

VITE_APP_NAME="${APP_NAME}"